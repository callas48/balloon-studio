{
  "name": "balloon-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "dev": "node scripts/dev-local.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "desktop": "electron .",
    "desktop:dir": "node scripts/build.mjs && electron-builder --win --dir --publish never",
    "desktop:installer": "node scripts/build.mjs && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "node tests/desktop-updates.cjs && node tests/desktop-files.cjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "version": "0.1.1",
  "description": "말풍선 공방 Windows 만화 편집기",
  "main": "desktop/main.cjs",
  "author": "Balloon Studio",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
